{
  "name": "@lkmc/system7-ui",
  "version": "0.1.5",
  "description": "Reusable System 7 style Svelte UI components",
  "license": "Unlicense",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "scripts": {
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "package": "svelte-package --input src --output dist && publint",
    "prepublishOnly": "npm run package",
    "publish:npm": "./scripts/publish-npm.sh",
    "demo:install": "npm install --prefix demo",
    "demo:dev": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/system7.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "publint": "^0.2.12",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2"
  },
  "dependencies": {
    "markdown-it": "^14.1.1"
  }
}
